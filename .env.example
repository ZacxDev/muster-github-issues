# Copy to .env and fill in. Placeholders only: never commit a real token.

# muster's address: https://, or http:// to localhost / 127.0.0.1 / [::1] only.
MUSTER_URL=https://muster.example.com

# The plugin token (mpl_…), shown once when you create the plugin on muster's
# /plugins page. It opens muster's /plugin/v1/* routes only, acting as you.
MUSTER_PLUGIN_TOKEN=mpl_replace_me

# A fine-grained GitHub token with read-only "Issues" access on the
# repositories below (and the "Metadata: read" GitHub adds to every token).
GITHUB_TOKEN=github_pat_replace_me

# The repositories to poll: owner/name, comma-separated.
GITHUB_REPOS=example-org/example-repo

# Optional: only issues carrying at least one of these labels (comma-separated).
# Leave empty for every issue.
GITHUB_LABELS=

# Optional: how often to poll (a Go duration, at least 10s). Default 1m.
GITHUB_POLL_INTERVAL=1m

# Optional: on the very first start, file issues updated since this time
# (RFC 3339). Default: the first start's own time (no backfill).
GITHUB_SINCE=

# Optional: the task key namespace; it must be in muster's
# MUSTER_PLUGIN_TASK_NAMESPACES. Default github.
GITHUB_TASK_NAMESPACE=github

# Optional: how fast the plugin files into muster (tasks and comments an hour,
# and a burst). A backfill (GITHUB_SINCE far back) or a busy repository waits
# in the outbox and reaches your chief at this pace. Default 60 and 10.
GITHUB_MAX_PER_HOUR=60
GITHUB_BURST=10

# Optional: GitHub's API address (GitHub Enterprise Server: https://<host>/api/v3).
GITHUB_API_URL=https://api.github.com

# Optional: where the outbox and the cursors live (default ./state). Keep it
# across restarts: it is what stops an issue being filed twice, and an update
# being skipped. Left commented out on purpose: under `docker run --env-file`
# a value here would override the image's STATE_DIR=/state, and the state
# would land outside the /state volume and be lost with the container.
# STATE_DIR=./state
